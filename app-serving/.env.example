# Copy to app-serving/.env only to change the defaults below. The API key and
# endpoint are read from the REPO's .env (ATAI_API_ENDPOINT, ATAI_API_KEY), the
# same file the Python stages use, and stay with the serving bridge: the browser
# never sees them. Agent serving is on Dev and Staging only.

# --- host ports ---------------------------------------------------------------
# app-serving's slot, next to app/'s, so both TEP monitors can run side by side:
#
#   app                            MQTT TCP  MQTT WS  Web   Agent admin
#   Anomaly Discovery (TEP, app/)  1889      9007     5179  9099
#   AD TEP, served (this)          1890      9008     5180  9100 (the serving bridge)
#
# MQTT_PORT=1890
# AGENT_PORT=9100
# PUBLIC_MQTT_TCP_PORT=1890
# PUBLIC_MQTT_WS_PORT=9008
# RUN=1               # which run the replayer starts on
